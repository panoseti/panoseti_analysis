// Laptop / local development profile — no container needed.
// Assumes `uv sync` has been run in this repo so .venv exists.
process {
    executor = 'local'
    cpus = 2
    memory = '4 GB'
    // Prepend the project venv so bin/ scripts pick up the right Python + packages.
    beforeScript = "export PATH=\"${projectDir}/.venv/bin:\$PATH\""
}

docker.enabled = false
singularity.enabled = false
