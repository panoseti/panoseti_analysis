nextflow.enable.dsl = 2
nextflow.enable.strict = true

manifest {
    name = 'panoseti-zarr-pipeline'
    description = 'PFF → Zarr v3 conversion + calibration demo'
    version = '0.3.0'
    nextflowVersion = '>=26.04'
    author = 'Nicolas Rault-Wang'
}

// ── Default parameters ────────────────────────────────────────────────────────
params {
    input_obs_dir = "${projectDir}/obs_TEST.pffd"
    outdir = "${projectDir}/results"

    // PFF → Zarr (L0)
    codec = 'zstd'
    level = 5
    time_chunk = 0
    // 0 = auto-sized by pypff.zarr

    // Pulse-height calibration
    ph_sigma = 5.0
    ph_offset = 800
    ph_stride = 200
    // frame stride for pedestal estimation

    // Image-mode calibration
    img_stride = 200
    img_block = 8
    img_adc_to_pe = 1.5

    // SLURM overrides (ignored on laptop profile)
    slurm_queue = 'debug'
    slurm_account = ''
}

// ── Profiles ─────────────────────────────────────────────────────────────────
profiles {
    laptop {
        includeConfig 'conf/laptop.config'
    }
    docker {
        includeConfig 'conf/docker.config'
    }
    hpc_slurm {
        includeConfig 'conf/hpc_slurm.config'
    }
}

// Base output directory for the output {} publishing block (Nextflow 24.10+)
outputDir = params.outdir

// ── Execution reports ─────────────────────────────────────────────────────────
timeline {
    enabled = true
    file = "${params.outdir}/logs/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/logs/report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/logs/trace.txt"
    overwrite = true
}
