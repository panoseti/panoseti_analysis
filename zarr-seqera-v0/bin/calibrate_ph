#!/usr/bin/env python3
"""Pulse-height calibration: pedestal subtraction + n-sigma thresholding."""
from __future__ import annotations

from pathlib import Path
from typing import Annotated

import typer
from panoseti_zarr_pipeline.calibrate_ph import calibrate_ph

app = typer.Typer(help=__doc__, add_completion=False)


@app.command()
def main(
    l0_store: Annotated[Path, typer.Argument(help="Input L0 .zarr store path")],
    l1_store: Annotated[Path, typer.Argument(help="Output L1 .zarr store path")],
    sigma: Annotated[float, typer.Option("--sigma", help="n-sigma threshold")] = 5.0,
    offset: Annotated[int, typer.Option("--offset", help="Baseline offset added before median")] = 800,
    stride: Annotated[int, typer.Option("--stride", help="Frame stride for pedestal estimation")] = 200,
    codec: Annotated[str, typer.Option(help="Zarr codec")] = "zstd",
    level: Annotated[int, typer.Option(help="Compression level")] = 5,
) -> None:
    typer.echo(f"Calibrating ph store: {l0_store.name}")
    calibrate_ph(
        l0_store, l1_store,
        sigma_threshold=sigma,
        baseline_offset=offset,
        frame_stride=stride,
        codec=codec,
        level=level,
    )
    typer.echo(f"Done → {l1_store}")


if __name__ == "__main__":
    app()
