/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as follows:
        nextflow run panoseti/analysis -profile test,laptop --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal bundled obs_TEST.pffd to check pipeline function'

    // Add ML steps to the smoke test
    steps = 'ingest,ml'
    cloud_model_pt = "${projectDir}/assets/models/cloud_detector_v1.pt"

    // Bundled truncated observation (ph256 + img16, module_1).
    input_obs_dir = "${projectDir}/tests/data/obs_TEST.pffd"

    // Small strides so calibration statistics are meaningful on the truncated data.
    ph_stride  = 50
    img_stride = 50
}
