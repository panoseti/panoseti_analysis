// HPC SLURM profile — Expanse / SDSC or any SLURM cluster.
// Override slurm_queue and slurm_account via --slurm_queue / --slurm_account params.
process {
    executor = 'slurm'
    queue = { params.slurm_queue }
    cpus = 4
    memory = '16 GB'
    time = '30m'
    clusterOptions = {
        def acct = params.slurm_account ? "--account=${params.slurm_account}" : ''
        "--nodes=1 --ntasks=1 ${acct} -o logs/%x-%j.out -e logs/%x-%j.err"
    }
    scratch = true
    beforeScript = '''
        set -euo pipefail
        mkdir -p logs
        export SCRATCH_DIR="/scratch/$USER/job_${SLURM_JOB_ID:-local}"
        mkdir -p "$SCRATCH_DIR/tmp"
        export TMPDIR="$SCRATCH_DIR/tmp"
    '''
}

executor {
    queueSize = 8
    submitRateLimit = '1 sec'
    pollInterval = '15 sec'
}

singularity {
    enabled = true
    autoMounts = true
}

// Convert Docker image to SIF for Singularity:
//   singularity pull panoseti-zarr-pipeline_0.3.0.sif \
//       docker://panoseti-zarr-pipeline:0.3.0
// or reference a registry image directly.
process.container = 'panoseti-zarr-pipeline:0.3.0'
