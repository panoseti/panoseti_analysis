/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    panoseti/analysis — hpc_slurm profile (SDSC Expanse: SLURM + Apptainer)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal-but-valid baseline; M6 adds scratch staging, module loads, Apptainer
    image-cache pinning, and queue/account schema entries.
*/

process {
    executor       = 'slurm'
    queue          = { params.slurm_queue }
    clusterOptions = { params.slurm_account ? "--account=${params.slurm_account}" : '' }
    container      = params.container ?: 'panoseti-analysis-ingest:0.1.0'
}

executor {
    queueSize       = 50
    submitRateLimit = '10/1min'
    pollInterval    = '30 sec'
}

apptainer {
    enabled    = true
    autoMounts = true
}
docker.enabled      = false
singularity.enabled = false
conda.enabled       = false

process {
    withLabel: gpu_ray {
        queue          = { params.slurm_gpu_queue ?: params.slurm_queue }
        clusterOptions = { (params.slurm_account ? "--account=${params.slurm_account}" : '') + ' --gres=gpu:2' }
        container      = params.ml_container ?: 'panoseti-analysis-ml:0.1.0'
    }
}

params {
    shard_factor_l0 = 16
    shard_factor_l1 = 8
}
