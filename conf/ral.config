/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    panoseti/analysis — RAL profile (bare-metal Ray cluster, no SLURM, no containers)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Runs on the PANOSETI Remote Access Laboratory:
      Head:      radiopi5 (Pi 5 — runs Nextflow JVM, lightweight coordinator only)
      GPU nodes: a6k (2× RTX A6000 48 GB + 1 TB SSD NVMe)
                 gf  (RTX 4070 + RTX 5070 + 1 TB SSD NVMe)
      Storage:   BeeGFS at /mnt/beegfs (shared across all nodes)

    All Nextflow processes run on the launching node via the `local` executor
    (typically run from a6k or gf, not radiopi5, for CPU-heavy ingest).
    For gpu_ray processes, the externally-owned Ray cluster (started by the user)
    handles GPU placement — Nextflow just launches the pa-ray-* CLI that attaches to it.

    Usage:
        nextflow run . -profile ral --steps ingest --input samplesheet.csv --outdir ...
        # With Ray ML inference:
        nextflow run . -profile ral --steps ingest,ml --use_ray true --input_obs_dir ...
*/

process {
    executor     = 'local'
    beforeScript = "export PATH=\"${projectDir}/.venv/bin:\$PATH\""
}

// Resource overrides tuned for RAL GPU nodes (a6k: ~192 GB RAM, 48+ cores).
// Run Nextflow from a6k or gf, not from radiopi5, to exploit these budgets.
process {
    withLabel: cpu_light {
        cpus   = { 2                    }
        memory = { 4.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel: cpu_fanout {
        cpus   = { 8     * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: io_heavy {
        // BeeGFS reads: extra RAM to buffer; parallelism limited by BeeGFS throughput.
        cpus   = { 4     * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }
    withLabel: gpu_ray {
        cpus   = { 4                    }
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
        // No SLURM accelerator directive: the externally-owned Ray cluster
        // manages GPU placement via resource_bundles / accelerator_type tags.
    }
}

params {
    // RAL uses attach mode: pa-ray-* CLIs connect to the user's pre-running cluster.
    // Start the cluster manually before running the pipeline:
    //   ray start --head --num-gpus=2   # on a6k
    //   ray start --address=a6k:6379    # on gf (optional second GPU node)
    ray_launcher = 'attach'
}

docker.enabled      = false
singularity.enabled = false
apptainer.enabled   = false
conda.enabled       = false
