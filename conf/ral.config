/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    panoseti/analysis — RAL profile (bare-metal Ray cluster, no SLURM, no containers)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Runs on the PANOSETI Remote Access Laboratory:
      Head:     digilab-receiver (2× RTX A6000 48 GB + 1 TB SSD NVMe; hosts dashboard)
      Serve:    digilab-transmit (gaming GPU, accelerator_type:G)
      Storage:  panoseti-dfs0/1/2 (BeeGFS CPU nodes)
      FS:       BeeGFS at /mnt/beegfs (shared across all nodes)

    Starting the Ray cluster (replaces manual ray start in tmux):
        ray up conf/ray/ral_cluster.yaml           # start / reconnect all 5 nodes
        ray up conf/ray/ral_cluster.yaml --no-restart  # attach without restarting
        ray status                                 # verify workers connected
        cd ~/ray-test && docker compose up -d      # prometheus + grafana

    All Nextflow processes run on the launching node via the `local` executor
    (run from digilab-receiver for access to BeeGFS and GPU resources).
    For gpu_ray processes, the externally-owned Ray cluster handles GPU placement.

    Usage:
        nextflow run . -profile ral --steps ingest --input samplesheet.csv --outdir ...
        nextflow run . -profile ral --steps ingest,ml --use_ray true --input_obs_dir ...
*/

process {
    executor     = 'local'
    beforeScript = "export PATH=\"${projectDir}/.venv/bin:\$PATH\""
}

// Resource overrides tuned for RAL GPU nodes (a6k: ~192 GB RAM, 48+ cores).
// Run Nextflow from a6k or gf, not from radiopi5, to exploit these budgets.
process {
    withLabel: cpu_light {
        cpus   = { 2                    }
        memory = { 4.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel: cpu_fanout {
        cpus   = { 8     * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: io_heavy {
        // BeeGFS reads: extra RAM to buffer; parallelism limited by BeeGFS throughput.
        cpus   = { 4     * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }
    withLabel: gpu_ray {
        cpus   = { 4                    }
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
        // No SLURM accelerator directive: the externally-owned Ray cluster
        // manages GPU placement via resource_bundles / accelerator_type tags.
    }
}

params {
    // RAL uses attach mode: pa-ray-* CLIs connect to the user's pre-running cluster.
    // Start with: ray up conf/ray/ral_cluster.yaml
    ray_launcher    = 'attach'
    shard_factor_l0 = 16  // ~78x file reduction for img16 on BeeGFS
    shard_factor_l1 = 8   // ~8x file reduction for L1 on BeeGFS
}

docker.enabled      = false
singularity.enabled = false
apptainer.enabled   = false
conda.enabled       = false
