// Docker profile — runs all processes inside the panoseti-zarr-pipeline container.
// Build the image first (from the parent directory):
//   docker build -t panoseti-zarr-pipeline:0.3.0 \
//       -f panoseti_zarr_seqera/Dockerfile .
process {
    executor = 'local'
    cpus = 2
    memory = '4 GB'
    container = 'panoseti-zarr-pipeline:0.3.0'
}

docker {
    enabled = true
    runOptions = '--rm'
}

singularity.enabled = false
