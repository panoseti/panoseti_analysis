/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    panoseti/analysis — laptop profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Local executor, no container. Runs the pa-* CLIs from the uv .venv on PATH.
    Resource labels (cpu_light/cpu_fanout/io_heavy/...) come from conf/base.config.
*/

process {
    executor     = 'local'
    container    = params.container ?: 'panoseti-analysis-ingest:0.1.0'
}

docker.enabled      = true
docker.runOptions   = '-u $(id -u):$(id -g)'
singularity.enabled = false
apptainer.enabled   = false
conda.enabled       = false
