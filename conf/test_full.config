/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size PANOSETI tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Requires real observation data. Not run in standard CI.

    Use as follows:
        nextflow run . -profile test_full,hpc_slurm --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full-size test profile'
    config_profile_description = 'Full observing run for end-to-end validation (requires HPC + data)'

    // Override with a real samplesheet path when running full tests
    // input = '/path/to/samplesheet.csv'
}
